<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>고독정식을 피해라!</title>
    <link href="https://fonts.googleapis.com/css2?family=Galmuri11:wght@700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
        body { 
            font-family: 'Galmuri11', sans-serif; 
            background: #111; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; overflow: hidden; 
        }
        
        #game-container { 
            width: 100vw; max-width: 450px; height: 100vh; 
            background-image: url('data:image/png;base64,');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            position: relative; overflow: hidden; border: 1px solid #444; 
        }

        #start-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('data:image/png;base64,');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            z-index: 300; display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
            padding-bottom: 7%;
        }
        
        #main-start-btn {
            width: 75%; height: 65px; background: transparent; border: none; cursor: pointer;
            -webkit-tap-highlight-color: transparent; margin-bottom: 12px; z-index: 301;
        }
        #main-howto-btn {
            width: 75%; height: 65px; background: transparent; border: none; cursor: pointer;
            -webkit-tap-highlight-color: transparent; margin-bottom: 15px; z-index: 301;
        }

        #howto-screen {
            display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url('data:image/png;base64,');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            z-index: 310; flex-direction: column; justify-content: flex-end; align-items: center;
            padding-bottom: 9%;
        }
        #howto-start-btn {
            width: 75%; height: 65px; background: transparent; border: none; cursor: pointer;
            -webkit-tap-highlight-color: transparent; z-index: 311;
        }

        .top-ui {
            position: absolute; top: 0; left: 0; width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 20px; z-index: 100;
        }
        .lives { font-size: 1.5rem; letter-spacing: 2px; text-shadow: 2px 2px 0 #000; }
        .score { font-size: 1.2rem; color: #ffbe0b; background: rgba(0,0,0,0.7); padding: 5px 15px; border-radius: 15px; border: 2px solid #ff477e; text-shadow: 1px 1px 0 #000; }

        #game-field {
            position: absolute; top: 0; left: 0; width: 100%; height: calc(100vh - 100px); overflow: hidden;
        }

        #player {
            position: absolute; bottom: 10px; left: 50%; width: 95px; height: 95px;
            transform: translateX(-50%); z-index: 50;
            background-image: url('data:image/png;base64,');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: contain;
        }

        .falling-object {
            position: absolute; width: 50px; height: 50px;
            z-index: 10;
            background-repeat: no-repeat;
            background-position: center center;
            background-size: contain;
        }

        .control-pad {
            position: absolute; bottom: 0; left: 0; width: 100%; height: 100px;
            display: flex; background: rgba(0,0,0,0.85); border-top: 3px solid #ff477e; z-index: 110;
        }
        .ctrl-btn {
            flex: 1; display: flex; justify-content: center; align-items: center;
            font-size: 1.8rem; font-weight: bold; color: white; background: transparent;
            border: none; cursor: pointer; -webkit-tap-highlight-color: transparent;
            text-shadow: 2px 2px 0 #000;
        }
        .ctrl-btn:active { background: rgba(255, 67, 126, 0.3); }
        .ctrl-btn-left { border-right: 1px solid #444; }

        #end-screen { 
            display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
            z-index: 400; flex-direction: column; justify-content: flex-end; align-items: center; 
            padding-bottom: 7%;
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
        }
        #retry-trigger-btn {
            width: 65%; height: 65px; background: transparent; border: none; cursor: pointer;
            -webkit-tap-highlight-color: transparent; z-index: 401;
        }
        
        .hit-effect { animation: flash 0.15s ease-out 2; }
        @keyframes flash {
            0% { background-color: rgba(255, 0, 0, 0); }
            50% { background-color: rgba(255, 0, 0, 0.5); }
            100% { background-color: rgba(255, 0, 0, 0); }
        }
    </style>
</head>
<body>

<div id="game-container">
    <div id="start-screen">
        <button id="main-start-btn"></button>
        <button id="main-howto-btn"></button>
    </div>

    <div id="howto-screen">
        <button id="howto-start-btn"></button>
    </div>

    <div class="top-ui">
        <div class="lives" id="lives-display">❤️❤️❤️</div>
        <div class="score">데이트권: <span id="score-display">0</span>/5</div>
    </div>

    <div id="game-field">
        <div id="player"></div>
    </div>

    <div class="control-pad">
        <button class="ctrl-btn ctrl-btn-left" id="btn-left">◀ LEFT</button>
        <button class="ctrl-btn" id="btn-right">RIGHT ▶</button>
    </div>

    <div id="end-screen">
        <button id="retry-trigger-btn" onclick="resetGame()"></button>
    </div>
</div>

<script>
    // Base64 이미지 데이터
    const IMG_TICKET = 'data:image/png;base64,';
    const IMG_JJAJANG = 'data:image/png;base64,';
    const IMG_WIN = 'data:image/png;base64,';
    const IMG_LOSE = 'data:image/png;base64,';

    let playerX = 50; 
    let lives = 3;
    let score = 0;
    let isPlaying = false; 
    let objects = [];
    let gameLoopId, spawnLoopId;
    let speedMultiplier = 1; 
    let keys = { left: false, right: false };
    let currentSpawnInterval = 600; // 현재 스폰 간격 (ms)

    const container = document.getElementById('game-container');
    const startScreen = document.getElementById('start-screen');
    const howtoScreen = document.getElementById('howto-screen');
    const endScreen = document.getElementById('end-screen');
    
    const mainStartBtn = document.getElementById('main-start-btn');
    const mainHowtoBtn = document.getElementById('main-howto-btn');
    const howtoStartBtn = document.getElementById('howto-start-btn');

    const gameField = document.getElementById('game-field');
    const player = document.getElementById('player');
    const livesDisplay = document.getElementById('lives-display');
    const scoreDisplay = document.getElementById('score-display');

    // 1. GAME START 클릭 시 즉시 게임 시작
    mainStartBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        startScreen.style.display = 'none';
        realGameStart();
    });

    mainStartBtn.addEventListener('touchend', function(e) {
        e.preventDefault();
        e.stopPropagation();
        startScreen.style.display = 'none';
        realGameStart();
    });

    // 2. HOW TO PLAY 클릭 시 설명 화면으로 이동
    mainHowtoBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        startScreen.style.display = 'none';
        howtoScreen.style.display = 'flex';
    });

    mainHowtoBtn.addEventListener('touchend', function(e) {
        e.preventDefault();
        e.stopPropagation();
        startScreen.style.display = 'none';
        howtoScreen.style.display = 'flex';
    });

    // 3. 설명 화면 내 GAME START 클릭 시 게임 시작
    howtoStartBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        howtoScreen.style.display = 'none';
        realGameStart();
    });

    howtoStartBtn.addEventListener('touchend', function(e) {
        e.preventDefault();
        e.stopPropagation();
        howtoScreen.style.display = 'none';
        realGameStart();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = true;
        if (e.key === 'ArrowRight' || e.key === 'd') keys.right = true;
    });
    document.addEventListener('keyup', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = false;
        if (e.key === 'ArrowRight' || e.key === 'd') keys.right = false;
    });

    const btnLeft = document.getElementById('btn-left');
    const btnRight = document.getElementById('btn-right');

    const setLeft = (val) => { keys.left = val; };
    const setRight = (val) => { keys.right = val; };

    btnLeft.addEventListener('mousedown', () => setLeft(true));
    btnLeft.addEventListener('mouseup', () => setLeft(false));
    btnLeft.addEventListener('mouseleave', () => setLeft(false));
    btnLeft.addEventListener('touchstart', (e) => { e.preventDefault(); setLeft(true); });
    btnLeft.addEventListener('touchend', () => setLeft(false));

    btnRight.addEventListener('mousedown', () => setRight(true));
    btnRight.addEventListener('mouseup', () => setRight(false));
    btnRight.addEventListener('mouseleave', () => setRight(false));
    btnRight.addEventListener('touchstart', (e) => { e.preventDefault(); setRight(true); });
    btnRight.addEventListener('touchend', () => setRight(false));

    function spawnObject() {
        if (!isPlaying) return;

        const obj = document.createElement('div');
        obj.classList.add('falling-object');
        
        const rand = Math.random();
        let type = 'jjajang';
        
        // 확률: 짜장면 85%, 슈퍼데이트권 15%
        if (rand < 0.85) {
            obj.style.backgroundImage = `url('${IMG_JJAJANG}')`;
            type = 'jjajang';
        } else {
            obj.style.backgroundImage = `url('${IMG_TICKET}')`;
            type = 'ticket';
        }

        obj.style.left = (Math.random() * 85 + 5) + '%';
        obj.style.top = '-60px';
        gameField.appendChild(obj);

        objects.push({ element: obj, top: -60, type: type });
    }

    function updateGame() {
        if (!isPlaying) return;

        if (keys.left) playerX -= 1.6;
        if (keys.right) playerX += 1.6;
        if (playerX < 8) playerX = 8;
        if (playerX > 92) playerX = 92;
        player.style.left = playerX + '%';

        // 📈 천천히 빨라지기 (프레임당 0.0001씩 증가)
        speedMultiplier += 0.0001; 
        const fieldHeight = gameField.offsetHeight;

        let rect1 = player.getBoundingClientRect();
        let playerCenterX = rect1.left + rect1.width / 2;
        let playerCenterY = rect1.top + rect1.height / 2;

        for (let i = objects.length - 1; i >= 0; i--) {
            let obj = objects[i];
            obj.top += 4.5 * speedMultiplier; 
            obj.element.style.top = obj.top + 'px';

            if (obj.top > fieldHeight) {
                obj.element.remove();
                objects.splice(i, 1);
                continue;
            }

            let rect2 = obj.element.getBoundingClientRect();
            let objCenterX = rect2.left + rect2.width / 2;
            let objCenterY = rect2.top + rect2.height / 2;

            let dx = playerCenterX - objCenterX;
            let dy = playerCenterY - objCenterY;
            let distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < 36) {
                handleCollision(obj.type);
                obj.element.remove();
                objects.splice(i, 1);
            }
        }

        gameLoopId = requestAnimationFrame(updateGame);
    }

    function handleCollision(type) {
        if (type === 'jjajang') {
            lives--;
            updateLivesUI();
            container.classList.add('hit-effect');
            setTimeout(() => container.classList.remove('hit-effect'), 300);
            if (lives <= 0) endGame('lose');
        } else if (type === 'ticket') {
            score++;
            console.log(`✅ 슈퍼데이트권 획득! 총 획득: ${score}/5`);
            console.log(`⚡ 난이도 상승: 스폰 속도 ${currentSpawnInterval}ms`);
            scoreDisplay.innerText = score;
            
            // 🚀 난이도 상승: 점수마다 스폰 속도 20ms씩 빨라짐 (최소 300ms)
            if (currentSpawnInterval > 300) {
                currentSpawnInterval = Math.max(300, currentSpawnInterval - 20);
                clearInterval(spawnLoopId);
                spawnLoopId = setInterval(spawnObject, currentSpawnInterval);
            }
            
            if (score >= 5) {
                endGame('win');
            }
        }
    }

    function updateLivesUI() {
        let heartStr = '';
        for (let i = 0; i < 3; i++) {
            heartStr += i < lives ? '❤️' : '🖤';
        }
        livesDisplay.innerText = heartStr;
    }

    function endGame(result) {
        isPlaying = false;
        cancelAnimationFrame(gameLoopId);
        clearInterval(spawnLoopId);

        objects.forEach(obj => obj.element.remove());
        objects = [];
        keys.left = false;
        keys.right = false;

        if (result === 'win') {
            endScreen.style.backgroundImage = `url('${IMG_WIN}')`;
        } else {
            endScreen.style.backgroundImage = `url('${IMG_LOSE}')`;
        }
        endScreen.style.display = 'flex';
    }

    function realGameStart() {
        isPlaying = true;
        playerX = 50;
        player.style.left = '50%';
        score = 0;
        lives = 3;
        speedMultiplier = 1;
        currentSpawnInterval = 600; // 초기 스폰 속도 (600ms)
        
        scoreDisplay.innerText = score;
        updateLivesUI();

        clearInterval(spawnLoopId);
        spawnLoopId = setInterval(spawnObject, currentSpawnInterval);
        updateGame();
    }

    function resetGame() {
        endScreen.style.display = 'none';
        lives = 3;
        score = 0;
        speedMultiplier = 1;
        currentSpawnInterval = 600;
        realGameStart();
    }
</script>

</body>
</html>
